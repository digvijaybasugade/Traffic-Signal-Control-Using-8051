#include<reg51.h>
sbit red = P1^0;
sbit yellow = P1^1;
sbit green = P1^2;
sbit RS = P3^0;
sbit RW = P3^1;
sbit EN = P3^2;

#define data_line P2

void delay_sec(int);
void lcd_init(void);
void lcd_cmd(unsigned char);
void lcd_data(unsigned char);
void lcd_string(unsigned char *);

void red_light()
{
	int i;
	red = 1;
	green = 0;
	yellow = 0;
	lcd_cmd(0X01);
	lcd_cmd(0X80);
	lcd_string("RED SIGNAL");
	for (i=9;i>=0;i--)
	{
		lcd_cmd(0XC0);
		lcd_data(i+ '0');
		delay_sec(20);
	}
}
void green_light()
{
	int i;
	red = 0;
	green = 1;
	yellow = 0;
	lcd_cmd(0X01);
	lcd_cmd(0X80);
	lcd_string("GREEN SIGNAL");
	for (i=6;i>=0;i--)
	{
		lcd_cmd(0XC0);
		lcd_data(i+ '0');
		delay_sec(20);
	}
}
void yellow_light()
{
	int i;
	red = 0;
	green = 0;
	yellow = 1;
	lcd_cmd(0X01);
	lcd_cmd(0X80);
	lcd_string("YELLOW SIGNAL");
	for (i=3;i>=0;i--)
	{
		lcd_cmd(0XC0);
		lcd_data(i+ '0');
		delay_sec(20);
	}
}
void main()
{
	lcd_init();
	lcd_string("TRAFFIC SIGNAL");
	red = 0;
	green = 0;
	yellow = 0;
	while(1)
	{
		red_light();
		green_light();
		yellow_light();
	}
}
void lcd_init(void)
{
	lcd_cmd(0X30);
	lcd_cmd(0X38);
	lcd_cmd(0X01);
	lcd_cmd(0X80);
	lcd_cmd(0X0C);
}
void lcd_cmd(unsigned char c)
{
	data_line = c;
	RS = 0;
	RW = 0;
	EN = 1;
	delay_sec(2);
	EN = 0;
}
void lcd_data(unsigned char d)
{
	data_line = d;
	RS = 1;
	RW = 0;
	EN = 1;
	delay_sec(2);
	EN = 0;
}
void lcd_string(unsigned char *p)
{
	while(*p!='\0')
	{
		lcd_data(*p);
		p++;
	}
}
void delay_sec(int t)
{
	int i;  
	for(i=0;i<t;i++)
	{
		TMOD = 0X01;
		TH0 = 0X4B;
		TL0 = 0XFD;
		TR0 = 1;   
		while(TF0 == 0);
		TR0 = 0;    
		TF0 = 0;   
	}
}
